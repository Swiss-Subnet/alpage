---
import fs from "node:fs/promises";
import path from "node:path";
import { marked } from "marked";
import Base from "../../layouts/Base.astro";

const repoBlob = "https://github.com/swiss-subnet/alpage/blob/main";

// Declared inside getStaticPaths and passed through props: Astro hoists
// getStaticPaths into its own scope, where module-level frontmatter consts are
// not in scope.
export function getStaticPaths() {
  return [
    {
      params: { doc: "config" },
      props: {
        file: "config.md",
        title: "Config reference",
        description:
          "The complete Alpage HCL config schema, generated from the Go struct tags so it always matches what the tool parses.",
      },
    },
    {
      params: { doc: "licensing" },
      props: {
        file: "licensing.md",
        title: "Licensing",
        description:
          "Plain-language guidance on the Business Source License 1.1 terms that govern Alpage: what is free, what needs a commercial licence.",
      },
    },
  ];
}

const meta = Astro.props as { file: string; title: string; description: string };

// Rendered from the repo's docs/ at build time: config.md is generated by
// `go generate ./nns`, so the site must not carry a second copy of it.
const raw = await fs.readFile(
  path.resolve(process.cwd(), "..", "docs", meta.file),
  "utf8",
);

// docs/ links are relative to the repo tree (../LICENSE, ./config.md); on the
// site those must point at GitHub or the sibling doc page.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rewritten = raw.replace(
  /\]\((\.{1,2}\/[^)]+)\)/g,
  (_m: string, target: string) => {
    const clean = target.replace(/^\.\//, "").replace(/^\.\.\//, "");
    const sibling = clean.match(/^(config|licensing)\.md(#.*)?$/);
    if (sibling) return `](${base}/docs/${sibling[1]}/${sibling[2] ?? ""})`;
    return `](${repoBlob}/${clean})`;
  },
);

// marked emits bare <h2>/<h3>, so in-page links like #schema-history had
// nothing to target. Slugs match GitHub's: lowercase, punctuation dropped,
// spaces to dashes, so the same anchor works in the repo and on the site.
const slug = (text: string) =>
  text
    .replace(/<[^>]*>/g, "")
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, "")
    .replace(/\s+/g, "-");

const renderer = new marked.Renderer();
// Slug from the token's raw text, not the rendered HTML: entities like &quot;
// and &lt; would otherwise leak into the id as "quotltnamegtquot".
renderer.heading = function ({ tokens, depth, text: raw }) {
  const text = this.parser.parseInline(tokens);
  return `<h${depth} id="${slug(raw)}">${text}</h${depth}>\n`;
};

const html = (await marked.parse(rewritten, { gfm: true, renderer })).replace(
  /<table>([\s\S]*?)<\/table>/g,
  '<div class="table-scroll"><table>$1</table></div>',
);
---

<Base title={`${meta.title} - Alpage`} description={meta.description}>
  <div class="wrap doc-wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={`${base}/`}>Alpage</a>
      <span aria-hidden="true">/</span>
      <span>{meta.title}</span>
    </nav>
    <article class:list={["prose", { wide: meta.file === "config.md" }]} set:html={html} />
  </div>
</Base>

<style>
  .doc-wrap {
    padding-top: 2.5rem;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    margin-bottom: 2rem;
  }

  .crumbs a {
    text-decoration: none;
  }

  /* Prose keeps a readable measure, but tables and code use the full container:
     the generated schema tables are far wider than 68ch and were being squeezed
     into half the page and forced to scroll. Headings and the block intro that
     labels a table span the full width too, so they line up with it rather than
     stopping short at the measure. */
  .prose {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
  }

  .prose > :global(*) {
    grid-column: 1;
  }

  /* The config schema is mostly full-width tables; a 68ch measure left its
     prose stranded in the left half beside them. Everything spans instead. */
  .prose.wide {
    display: block;
    max-width: none;
  }

  .prose :global(table),
  .prose :global(pre),
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3) {
    grid-column: 1 / -1;
  }

  .prose :global(h1) {
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    margin-bottom: 1.25rem;
  }

  .prose :global(h2) {
    font-size: 1.45rem;
    margin: 2.75rem 0 0.85rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .prose :global(h3) {
    font-size: 1.1rem;
    margin: 2rem 0 0.7rem;
    font-family: var(--mono);
  }

  .prose :global(h4) {
    font-size: 0.98rem;
    margin: 1.5rem 0 0.6rem;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--text-muted);
  }

  .prose :global(p) {
    margin: 0 0 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.35rem;
    margin: 0 0 1rem;
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(pre) {
    margin: 0 0 1.25rem;
  }

  /* marked emits plain fences (no shiki here), so keep the manual code theme. */

  .prose :global(blockquote) {
    margin: 0 0 1.25rem;
    padding: 0.75rem 1.1rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* Wrapped in a scroll container by the markdown pipeline, so the table itself
     can be a real table and wrap its text instead of nowrap-and-scroll. */
  .prose :global(.table-scroll) {
    grid-column: 1 / -1;
    overflow-x: auto;
    margin: 0 0 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .prose :global(table) {
    font-size: 0.87rem;
    min-width: 34rem;
    margin: 0;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .prose :global(th) {
    background: var(--bg-sunken);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    font-weight: 600;
  }

  .prose :global(td) {
    color: var(--text-muted);
    vertical-align: top;
  }

  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  /* Inline code held a token like --force across a line break, splitting it and
     leaving the background bleeding onto both lines. */
  .prose :global(td code),
  .prose :global(p code) {
    white-space: nowrap;
  }

  /* The chip's smaller font puts its baseline below the surrounding text's, so
     it hangs low on the line. Centring it on the parent's x-height instead of
     its own baseline sits it mid-line. */
  .prose :global(.since) {
    display: inline-block;
    vertical-align: 0.06em;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.35;
    padding: 0 0.5em;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-sunken);
    color: var(--text-faint);
    white-space: nowrap;
  }

  /* In a table cell the chip is the whole content, so centre it on the row's
     first line rather than nudging it against prose. */
  .prose :global(td > .since:only-child) {
    vertical-align: baseline;
  }

  /* In the block intro the chip leads the sentence, so it needs the gap a
     plain "Since v0.1.0." had. */
  .prose :global(p > .since:first-child) {
    margin-right: 0.4rem;
  }

  /* The first three columns are short tokens; the description takes the rest. */
  .prose :global(th:not(:last-child)),
  .prose :global(td:not(:last-child)) {
    white-space: nowrap;
    width: 1%;
  }
</style>
